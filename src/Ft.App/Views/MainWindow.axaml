<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ft.App.ViewModels"
        x:Class="Ft.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="FrameTerm"
        Icon="/Assets/app.ico"
        Width="1280" Height="800"
        MinWidth="980" MinHeight="640">
  <Window.Styles>
    <Style Selector="WrapPanel#ToolbarPanel > :is(Control)">
      <Setter Property="Margin" Value="0,3,6,3" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="22,18">

    <!-- Header: serif wordmark + connection pill | toolbar -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="2,0,2,16">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="FrameTerm" Classes="wordmark" FontSize="28"
                   Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
        <Border Classes="statusPill" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ConnectionStatus}" Classes="mono" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </StackPanel>
      <WrapPanel x:Name="ToolbarPanel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="ConnectButton" Classes="accent" Click="OnConnectClick"
                IsEnabled="{Binding !IsConnected}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{StaticResource IconLink}" />
            <TextBlock Text="Connect" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{StaticResource IconLinkOff}" />
            <TextBlock Text="Disconnect" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <ToggleButton IsChecked="{Binding IsDemoMode, Mode=OneWay}"
                      Command="{Binding ToggleDemoCommand}"
                      ToolTip.Tip="Run without hardware: echo transport + sample protocol">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{StaticResource IconChip}" />
            <TextBlock Text="Demo" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <Button Click="OnFrameDefClick" ToolTip.Tip="Framing, checksum, fields, highlight rules">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{StaticResource IconFrame}" />
            <TextBlock Text="Frame def" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Click="OnMacrosClick" ToolTip.Tip="Manage send macros (20 max, hotkeys)">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{StaticResource IconMacro}" />
            <TextBlock Text="Macros" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <ToggleButton IsChecked="{Binding IsLogging, Mode=OneWay}" Click="OnLogToggleClick"
                      ToolTip.Tip="Record raw traffic (hex + timestamps) to a file">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{StaticResource IconRecord}" />
            <TextBlock Text="Log" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <Button Click="OnOpenProjectClick" ToolTip.Tip="Open .ftproj project">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{StaticResource IconFolder}" />
            <TextBlock Text="Open" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Click="OnSaveProjectClick" ToolTip.Tip="Save session as .ftproj project">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{StaticResource IconSave}" />
            <TextBlock Text="Save" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <ToggleButton IsChecked="{Binding IsRawView}"
                      ToolTip.Tip="Continuous hex dump instead of the frame list">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{StaticResource IconFilter}" />
            <TextBlock Text="Raw" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <ComboBox ItemsSource="{Binding BytesPerRowOptions}"
                  SelectedIndex="{Binding BytesPerRowIndex}"
                  VerticalAlignment="Center" MinWidth="130" />
        <Button Command="{Binding ClearDumpCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{StaticResource IconTrash}" />
            <TextBlock Text="Clear" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </WrapPanel>
    </Grid>

    <!-- Dashboard stat strip: big mono counters, RX tile carries the green glow -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,14,*,14,*,14,*" Margin="0,0,0,16">
      <Border Grid.Column="0" Classes="statTile">
        <Panel>
          <Border CornerRadius="12" Background="{StaticResource GreenGlowBrush}"
                  Margin="-16,-12" />
          <StackPanel>
            <TextBlock Text="RX BYTES" Classes="statLabel" />
            <TextBlock Text="{Binding RxText}" Classes="statValue" />
          </StackPanel>
        </Panel>
      </Border>
      <Border Grid.Column="2" Classes="statTile">
        <StackPanel>
          <TextBlock Text="TX BYTES" Classes="statLabel" />
          <TextBlock Text="{Binding TxText}" Classes="statValue" />
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Classes="statTile">
        <StackPanel>
          <TextBlock Text="FRAMES" Classes="statLabel" />
          <TextBlock Text="{Binding FramesText}" Classes="statValue" />
        </StackPanel>
      </Border>
      <Border Grid.Column="6" Classes="statTile">
        <StackPanel>
          <TextBlock Text="ERRORS" Classes="statLabel" />
          <TextBlock Text="{Binding ErrorsText}" Classes="statValue" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Compose bar -->
    <Border DockPanel.Dock="Bottom" Classes="card" Padding="14,12" Margin="0,14,0,0">
      <StackPanel Spacing="9">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="accent" Margin="8,0,0,0"
                  Command="{Binding SendComposedCommand}"
                  IsEnabled="{Binding IsConnected}" IsDefault="True">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IconSend}" />
              <TextBlock Text="Send" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
            <ToggleButton IsChecked="{Binding RepeatEnabled}" Padding="12,5"
                          IsEnabled="{Binding IsConnected}"
                          ToolTip.Tip="Send repeatedly at the given period">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconRefresh}" Width="13" Height="13" />
                <TextBlock Text="Repeat" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <TextBox Text="{Binding RepeatMsText}" Width="64" Watermark="ms"
                     VerticalAlignment="Center" />
          </StackPanel>
          <TextBox Text="{Binding ComposeText}"
                   FontFamily="Menlo,Consolas,monospace"
                   Watermark="A5 01 {len} &quot;CMD&quot; {crc16}   — hex bytes, &quot;ascii&quot;, {len} {crc16} {crc:PRESET} {sum8} {xor8}" />
        </DockPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding ComposeError}" Classes="error"
                     VerticalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding Macros}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MacroViewModel">
                <Button Margin="0,0,6,0" Padding="10,4" FontSize="12"
                        Content="{Binding Name}" ToolTip.Tip="{Binding ToolTip}"
                        Command="{Binding RunCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Bottom status line + wordmark/copyright -->
    <Border DockPanel.Dock="Bottom" Padding="12,10,12,2">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding TrialStatusText}" Classes="muted" FontSize="11"
                     VerticalAlignment="Center" />
          <TextBlock Text="© 2026 TestBench.tools · All rights reserved." Classes="muted"
                     FontSize="11" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="TestBench" Classes="wordmark" FontSize="16"
                       Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
            <TextBlock Text=".tools" Classes="wordmark" FontSize="16"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="18">
          <TextBlock Text="{Binding PortSummary}" Classes="muted" />
          <TextBlock Text="{Binding StatsText}" Classes="muted" />
          <TextBlock Text="{Binding LastError}" Classes="error" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Central area: frame view or raw dump (toggle) -->
    <Panel>

      <!-- Frame list + detail -->
      <Grid RowDefinitions="2*,14,*" IsVisible="{Binding !IsRawView}">
        <Border Grid.Row="0" Classes="card" Padding="16">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="2,0,2,10">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                          VerticalAlignment="Center">
                <ToggleButton IsChecked="{Binding FilterErrorsOnly}" Padding="12,4" FontSize="12">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconWarning}" Width="12" Height="12" />
                    <TextBlock Text="Errors only" VerticalAlignment="Center" />
                  </StackPanel>
                </ToggleButton>
                <TextBox Text="{Binding FilterPattern}" Width="170" FontSize="12"
                         Watermark="Filter: A5 ?? 01" VerticalAlignment="Center" />
                <TextBlock Text="{Binding LogStatus}" Classes="error" FontSize="11"
                           VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="Frames" Classes="serifHeader" VerticalAlignment="Center" />
            </DockPanel>
            <DataGrid ItemsSource="{Binding FrameRecords}"
                      SelectedItem="{Binding SelectedFrame}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserReorderColumns="False">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="8">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:FrameRecordViewModel">
                      <Border Background="{Binding HighlightBrush}" Width="4" Margin="2,2"
                              CornerRadius="2" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="110" />
                <DataGridTemplateColumn Header="Dir" Width="50">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:FrameRecordViewModel">
                      <TextBlock Text="{Binding Dir}" Foreground="{Binding DirBrush}"
                                 FontWeight="Medium" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Len" Binding="{Binding Len}" Width="60" />
                <DataGridTemplateColumn Header="Checksum" Width="90">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:FrameRecordViewModel">
                      <TextBlock Text="{Binding ChecksumText}" Foreground="{Binding ChecksumBrush}"
                                 FontWeight="Medium" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Fields" Binding="{Binding FieldsSummary}" Width="*" />
                <DataGridTextColumn Header="Raw" Binding="{Binding RawPreview}" Width="2*"
                                    FontFamily="Menlo,Consolas,monospace" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <Border Grid.Row="2" Classes="card" Padding="16">
          <Grid ColumnDefinitions="3*,14,2*">
            <DockPanel Grid.Column="0">
              <TextBlock DockPanel.Dock="Top" Text="Selected frame" Classes="fieldLabel" />
              <ListBox ItemsSource="{Binding DetailRows}" Padding="2">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DumpRowViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                      <TextBlock Classes="mono muted" FontSize="12" Text="{Binding Offset}" />
                      <TextBlock Classes="mono" FontSize="12" Text="{Binding Hex}"
                                 Foreground="{Binding Brush}" />
                      <TextBlock Classes="mono muted" FontSize="12" Text="{Binding Ascii}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="4,1" />
                    <Setter Property="MinHeight" Value="0" />
                  </Style>
                </ListBox.Styles>
              </ListBox>
            </DockPanel>
            <DockPanel Grid.Column="2">
              <TextBlock DockPanel.Dock="Top" Text="Fields" Classes="fieldLabel" />
              <DataGrid ItemsSource="{Binding DetailFields}" AutoGenerateColumns="False"
                        IsReadOnly="True" HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- Raw dual hex+ASCII dump -->
      <Border Classes="card" Padding="16" IsVisible="{Binding IsRawView}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="18"
                      Margin="2,0,2,10" VerticalAlignment="Center">
            <TextBlock Text="Raw stream" Classes="serifHeader" VerticalAlignment="Center" />
            <TextBlock Text="time · dir · offset · hex · ascii" Classes="mono muted"
                       VerticalAlignment="Center" />
          </StackPanel>
          <DockPanel>
            <Border DockPanel.Dock="Bottom" MinHeight="22" Padding="8,2">
              <StackPanel Orientation="Horizontal" Spacing="14"
                          IsVisible="{Binding PartialRow, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="mono muted" FontSize="12" Text="{Binding PartialRow.Time}" />
                <TextBlock Classes="mono" FontSize="12" Text="{Binding PartialRow.Dir}"
                           Foreground="{Binding PartialRow.Brush}" />
                <TextBlock Classes="mono muted" FontSize="12" Text="{Binding PartialRow.Offset}" />
                <TextBlock Classes="mono" FontSize="12" Text="{Binding PartialRow.Hex}"
                           Foreground="{Binding PartialRow.Brush}" />
                <TextBlock Classes="mono muted" FontSize="12" Text="{Binding PartialRow.Ascii}" />
              </StackPanel>
            </Border>
            <ListBox x:Name="DumpList" ItemsSource="{Binding DumpRows}" Padding="4"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DumpRowViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Classes="mono muted" FontSize="12" Text="{Binding Time}" />
                    <TextBlock Classes="mono" FontSize="12" Text="{Binding Dir}"
                               Foreground="{Binding Brush}" />
                    <TextBlock Classes="mono muted" FontSize="12" Text="{Binding Offset}" />
                    <TextBlock Classes="mono" FontSize="12" Text="{Binding Hex}"
                               Foreground="{Binding Brush}" />
                    <TextBlock Classes="mono muted" FontSize="12" Text="{Binding Ascii}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="4,1" />
                  <Setter Property="MinHeight" Value="0" />
                </Style>
              </ListBox.Styles>
            </ListBox>
          </DockPanel>
        </DockPanel>
      </Border>

    </Panel>

  </DockPanel>
</Window>
