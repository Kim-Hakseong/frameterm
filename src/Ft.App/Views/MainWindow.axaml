<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ft.App.ViewModels"
        x:Class="Ft.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="FrameTerm"
        Icon="/Assets/app.ico"
        Width="1280" Height="760"
        MinWidth="980" MinHeight="600">
  <Window.Styles>
    <Style Selector="WrapPanel#ToolbarPanel > :is(Control)">
      <Setter Property="Margin" Value="0,3,6,3" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="16">

    <!-- Top bar card -->
    <Border DockPanel.Dock="Top" Classes="card" Padding="10,8" Margin="0,0,0,12">
      <DockPanel>
        <Border DockPanel.Dock="Left" Classes="pill" VerticalAlignment="Center"
                Background="{StaticResource CardBrush}">
          <TextBlock Text="FrameTerm" FontWeight="SemiBold" FontSize="14" />
        </Border>
        <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectionStatus}" Classes="muted"
                   VerticalAlignment="Center" Margin="12,0,6,0" />
        <WrapPanel x:Name="ToolbarPanel" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button x:Name="ConnectButton" Classes="accent" Click="OnConnectClick"
                  IsEnabled="{Binding !IsConnected}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IconLink}" />
              <TextBlock Text="Connect" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IconLinkOff}" />
              <TextBlock Text="Disconnect" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <ToggleButton IsChecked="{Binding IsDemoMode, Mode=OneWay}"
                        Command="{Binding ToggleDemoCommand}"
                        ToolTip.Tip="Run without hardware: echo transport + sample protocol">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IconChip}" />
              <TextBlock Text="Demo" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <Button Click="OnFrameDefClick" ToolTip.Tip="Framing, checksum, fields, highlight rules">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IconFrame}" />
              <TextBlock Text="Frame def" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Click="OnMacrosClick" ToolTip.Tip="Manage send macros (20 max, hotkeys)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IconMacro}" />
              <TextBlock Text="Macros" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <ToggleButton IsChecked="{Binding IsRawView}"
                        ToolTip.Tip="Continuous hex dump instead of the frame list">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IconFilter}" />
              <TextBlock Text="Raw" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ComboBox ItemsSource="{Binding BytesPerRowOptions}"
                    SelectedIndex="{Binding BytesPerRowIndex}"
                    VerticalAlignment="Center" MinWidth="130" />
          <Button Command="{Binding ClearDumpCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IconTrash}" />
              <TextBlock Text="Clear" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </WrapPanel>
      </DockPanel>
    </Border>

    <!-- Compose bar -->
    <Border DockPanel.Dock="Bottom" Classes="card" Padding="12,10" Margin="0,12,0,0">
      <StackPanel Spacing="8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="accent" Margin="8,0,0,0"
                  Command="{Binding SendComposedCommand}"
                  IsEnabled="{Binding IsConnected}" IsDefault="True">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IconSend}" />
              <TextBlock Text="Send" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
            <ToggleButton IsChecked="{Binding RepeatEnabled}" Padding="12,5"
                          IsEnabled="{Binding IsConnected}"
                          ToolTip.Tip="Send repeatedly at the given period">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconRefresh}" Width="13" Height="13" />
                <TextBlock Text="Repeat" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <TextBox Text="{Binding RepeatMsText}" Width="64" Watermark="ms"
                     VerticalAlignment="Center" />
          </StackPanel>
          <TextBox Text="{Binding ComposeText}"
                   FontFamily="Menlo,Consolas,monospace"
                   Watermark="A5 01 {len} &quot;CMD&quot; {crc16}   — hex bytes, &quot;ascii&quot;, {len} {crc16} {crc:PRESET} {sum8} {xor8}" />
        </DockPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding ComposeError}" Classes="error"
                     VerticalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding Macros}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MacroViewModel">
                <Button Margin="0,0,6,0" Padding="10,4" FontSize="12"
                        Content="{Binding Name}" ToolTip.Tip="{Binding ToolTip}"
                        Command="{Binding RunCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Bottom status line + logo/copyright -->
    <Border DockPanel.Dock="Bottom" Padding="12,8,12,2">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10"
                    VerticalAlignment="Center">
          <TextBlock Text="© 2026 NEXYS Co., Ltd. All rights reserved." Classes="muted"
                     FontSize="11" VerticalAlignment="Center" />
          <Image Source="/Assets/nexys-logo.png" Height="14" VerticalAlignment="Center"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="18">
          <TextBlock Text="{Binding PortSummary}" Classes="muted" />
          <TextBlock Text="{Binding StatsText}" Classes="muted" />
          <TextBlock Text="{Binding LastError}" Classes="error" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Central area: frame view or raw dump (toggle) -->
    <Panel>

      <!-- Frame list + detail -->
      <Grid RowDefinitions="2*,12,*" IsVisible="{Binding !IsRawView}">
        <Border Grid.Row="0" Classes="card" Padding="14">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="softCard" Padding="12,6" Margin="0,0,0,8">
              <TextBlock Text="Frames" Classes="sectionTitle" />
            </Border>
            <DataGrid ItemsSource="{Binding FrameRecords}"
                      SelectedItem="{Binding SelectedFrame}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserReorderColumns="False">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="8">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:FrameRecordViewModel">
                      <Border Background="{Binding HighlightBrush}" Width="4" Margin="2,2"
                              CornerRadius="2" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="110" />
                <DataGridTemplateColumn Header="Dir" Width="50">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:FrameRecordViewModel">
                      <TextBlock Text="{Binding Dir}" Foreground="{Binding DirBrush}"
                                 FontWeight="Medium" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Len" Binding="{Binding Len}" Width="60" />
                <DataGridTemplateColumn Header="Checksum" Width="90">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:FrameRecordViewModel">
                      <TextBlock Text="{Binding ChecksumText}" Foreground="{Binding ChecksumBrush}"
                                 FontWeight="Medium" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Fields" Binding="{Binding FieldsSummary}" Width="*" />
                <DataGridTextColumn Header="Raw" Binding="{Binding RawPreview}" Width="2*"
                                    FontFamily="Menlo,Consolas,monospace" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <Border Grid.Row="2" Classes="card" Padding="14">
          <Grid ColumnDefinitions="3*,12,2*">
            <DockPanel Grid.Column="0">
              <TextBlock DockPanel.Dock="Top" Text="Selected frame" Classes="fieldLabel" />
              <ListBox ItemsSource="{Binding DetailRows}" Padding="2">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DumpRowViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                      <TextBlock Classes="mono muted" FontSize="12" Text="{Binding Offset}" />
                      <TextBlock Classes="mono" FontSize="12" Text="{Binding Hex}"
                                 Foreground="{Binding Brush}" />
                      <TextBlock Classes="mono muted" FontSize="12" Text="{Binding Ascii}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="4,1" />
                    <Setter Property="MinHeight" Value="0" />
                  </Style>
                </ListBox.Styles>
              </ListBox>
            </DockPanel>
            <DockPanel Grid.Column="2">
              <TextBlock DockPanel.Dock="Top" Text="Fields" Classes="fieldLabel" />
              <DataGrid ItemsSource="{Binding DetailFields}" AutoGenerateColumns="False"
                        IsReadOnly="True" HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- Raw dual hex+ASCII dump -->
      <Border Classes="card" Padding="14" IsVisible="{Binding IsRawView}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="softCard" Padding="12,6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="24">
              <TextBlock Text="Raw stream" Classes="sectionTitle" VerticalAlignment="Center" />
              <TextBlock Text="time · dir · offset · hex · ascii" Classes="muted"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <DockPanel>
            <Border DockPanel.Dock="Bottom" MinHeight="22" Padding="8,2">
              <StackPanel Orientation="Horizontal" Spacing="14"
                          IsVisible="{Binding PartialRow, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="mono muted" FontSize="12" Text="{Binding PartialRow.Time}" />
                <TextBlock Classes="mono" FontSize="12" Text="{Binding PartialRow.Dir}"
                           Foreground="{Binding PartialRow.Brush}" />
                <TextBlock Classes="mono muted" FontSize="12" Text="{Binding PartialRow.Offset}" />
                <TextBlock Classes="mono" FontSize="12" Text="{Binding PartialRow.Hex}"
                           Foreground="{Binding PartialRow.Brush}" />
                <TextBlock Classes="mono muted" FontSize="12" Text="{Binding PartialRow.Ascii}" />
              </StackPanel>
            </Border>
            <ListBox x:Name="DumpList" ItemsSource="{Binding DumpRows}" Padding="4"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DumpRowViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Classes="mono muted" FontSize="12" Text="{Binding Time}" />
                    <TextBlock Classes="mono" FontSize="12" Text="{Binding Dir}"
                               Foreground="{Binding Brush}" />
                    <TextBlock Classes="mono muted" FontSize="12" Text="{Binding Offset}" />
                    <TextBlock Classes="mono" FontSize="12" Text="{Binding Hex}"
                               Foreground="{Binding Brush}" />
                    <TextBlock Classes="mono muted" FontSize="12" Text="{Binding Ascii}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="4,1" />
                  <Setter Property="MinHeight" Value="0" />
                </Style>
              </ListBox.Styles>
            </ListBox>
          </DockPanel>
        </DockPanel>
      </Border>

    </Panel>

  </DockPanel>
</Window>
